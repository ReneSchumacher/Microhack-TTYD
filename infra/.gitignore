# Terraform

# Local .terraform directories and plugins
**/.terraform/*

# State files (may contain secrets, managed remotely)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files that may contain sensitive data.
# Keep the project's committed configuration file.
*.tfvars
*.tfvars.json
!main.tfvars.json

# Override files (used for local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan output
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc

# Keep the dependency lock file committed:
.terraform.lock.hcl
